# ========================================
# متغيرات البيئة لـ CodeMentor Pro على Vercel
# ========================================

# قاعدة البيانات PostgreSQL (من Vercel Postgres أو Neon أو Supabase)
# احصل عليها من: https://vercel.com/dashboard/stores (Postgres)
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# ملاحظة: مفاتيح APIs الخارجية (YouTube, Telegram, Binance, GitHub, Discord)
# تُحفظ في localStorage الخاص بالمتصفح، وليست متغيرات بيئة.
# أدخلها من زر "المفاتيح" (🔑) في واجهة التطبيق.

# ===== المتغيرات الاختيارية للإنتاج =====
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
